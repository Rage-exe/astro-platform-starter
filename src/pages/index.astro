---
import Layout from '../layouts/Layout.astro';
import Markdown from '../components/Markdown.astro';

const explainer = `
Sport × Musique × Art visuel

RAGE.exe est une expérience immersive et collective où le sport devient un exutoire.
Un format hybride, physique et sensoriel, à la croisée de l’entraînement, de la musique et de l’art visuel.

`;

---

<Layout title="RAGE.exe">
    <h1 class="mb-10">RAGE.exe</h1>
    <Markdown content={explainer} class="mb-10 text-lg" />
    <p>
     <a href="#" class="btn btn-lg sm:min-w-64">Coming soon...</a>
    </p>
</Layout>
